{
  "name": "super-agent-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Super Agent brain: pi-agent-core loop running in Termux, talking to the Android body over localhost IPC",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "mock": "tsx test/mock-body.ts",
    "smoke": "tsx test/smoke.ts",
    "live-glm": "tsx test/live-glm.ts",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/main.ts",
    "contract": "tsx test/contract.ts",
    "integration": "tsx test/integration.ts",
    "tts-chain": "tsx test/tts-online-chain.ts",
    "memory-backup": "tsx src/memory/backup-cli.ts backup",
    "memory-restore": "tsx src/memory/backup-cli.ts restore",
    "evolve-report": "tsx src/memory/evolve-report.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "latest",
    "@earendil-works/pi-ai": "latest",
    "msedge-tts": "^2.0.7",
    "typebox": "^1.3.15"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
